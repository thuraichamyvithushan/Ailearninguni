# Local development defaults to demo mode. Set firebase for real accounts.
VITE_AUTH_MODE=demo
VITE_API_URL=/api
# Separate hosting: set this in Vercel to https://YOUR-BACKEND.vercel.app/api.

# Firebase web app configuration (public client identifiers).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
