# Local development defaults to demo mode. Set firebase for real accounts.
VITE_AUTH_MODE=demo
VITE_API_URL=/api
# deployment.config.js maps /api to the local proxy in development and the
# configured Vercel backend in production. A full URL overrides that default.

# Firebase web app configuration (public client identifiers).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
