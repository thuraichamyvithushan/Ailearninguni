# Demo mode is local only. Production requires firebase.
AUTH_MODE=demo
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# On Vercel, both URL values above must use the frontend's HTTPS origin.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Local Firebase credentials: absolute path to a file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel: set the complete service-account JSON as a server-only secret.
# Leave blank locally when using application default credentials above.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional stable local demo session signing key.
DEMO_JWT_SECRET=
