{
  "name": "ai-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "test": "npm run test --workspace backend",
    "seed": "npm run seed --workspace backend",
    "set-role": "npm run set-role --workspace backend --"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
